# Copy to .env locally. Never commit real API keys.
# Primary fixture/result provider (API-Football / API-Sports remains suspended and inactive).
FIVEDOLLARFOOTBALL_API_KEY=

# Supplemental bookmaker odds provider. The daily job limits calls to relevant competitions.
THE_ODDS_API_KEY=
# Optional comma-separated override; otherwise only competitions represented in the report are queried.
# THE_ODDS_API_SOCCER_SPORTS=soccer_epl,soccer_spain_la_liga

# InferSports is keyless but currently disabled because the bounded live probe returned no current quotes.
VELTRIX_ENABLE_INFERSports=false

# Optional separate BTTS / Over-Under odds enrichment source.
ODDSPAPI_API_KEY=

# Optional Telegram delivery / command centre configuration.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Legacy credentials are retained only for explicit historical audits; they are not active daily dependencies.
HIGHLIGHTLY_API_KEY=
HIGHLIGHTLY_API_BASE_URL=https://soccer.highlightly.net
API_FOOTBALL_KEY=
APIFOOTBALL_API_KEY=
