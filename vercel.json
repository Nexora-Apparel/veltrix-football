{
  "routes": [
    {
      "src": "^/$",
      "dest": "/api/dashboard"
    },
    {
      "src": "^/dashboard/?$",
      "dest": "/api/dashboard"
    },
    {
      "src": "^/api/dashboard/?$",
      "dest": "/api/index?route=dashboard"
    },
    {
      "src": "^/api/dashboard-data/?$",
      "dest": "/api/dashboard_data"
    },
    {
      "handle": "filesystem"
    }
  ],
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"command-data\" ]; then exit 0; else exit 1; fi"
}
